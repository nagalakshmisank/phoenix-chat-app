# ─── PRZMA .env ───────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — only commit .env.example
#
# cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────

# Phoenix secret key — generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Your server's public URL (no trailing slash)
PRZMA_INSTANCE_URL=https://your-domain.com
PRZMA_INSTANCE_HOST=your-domain.com

# PostgreSQL password for Oban job queue
POSTGRES_PASSWORD=

# ── Object Storage (Linode Object Storage) ────────────────────────────────────
# Your S3-compatible bucket. Works with Linode, Cloudflare R2, MinIO, AWS.
#
# Linode example (replace region/bucket with yours):
#   PRZMA_S3_ENDPOINT=https://in-maa-1.linodeobjects.com
#   PRZMA_S3_BUCKET=perkeep
#   PRZMA_S3_REGION=in-maa-1
#
# Get keys from: Linode console → Object Storage → Access Keys
# ROTATE IMMEDIATELY if exposed. Never put actual keys in this file.

PRZMA_S3_ENDPOINT=https://in-maa-1.linodeobjects.com
PRZMA_S3_BUCKET=perkeep
PRZMA_S3_REGION=in-maa-1

# S3 credentials — Elixir runtime.exs reads these
PRZMA_S3_ACCESS_KEY=your-linode-access-key
PRZMA_S3_SECRET=your-linode-secret-key

# S3 credentials — Rust object_store (LanceDB + CAS blob uploads) reads these
# Must match PRZMA_S3_ACCESS_KEY / PRZMA_S3_SECRET above
AWS_ACCESS_KEY_ID=your-linode-access-key
AWS_SECRET_ACCESS_KEY=your-linode-secret-key

# Deployment mode: cloud_saas | byos | local | own_domain
# Use "own_domain" when you self-host with your own S3 bucket (like Linode)
PRZMA_MODE=own_domain

# When using external S3 (Linode/R2/AWS), do NOT set PRZMA_LOCAL_PATH.
# Unset = Rust adapter uses CloudSaas mode → routes all blob writes to S3.
# PRZMA_LOCAL_PATH=/data/vaults   ← comment this out for cloud storage

# ── Optional ──────────────────────────────────────────────────────────────────

# Master encryption key — generate with: openssl rand -hex 32
# PRZMA_MASTER_KEY=

# Email notifications
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@your-domain.com

# ActivityPub federation (default: enabled)
# PRZMA_AP_ENABLED=true

# Erlang cluster (default: gossip on private network)
# PRZMA_CLUSTER_STRATEGY=gossip
# PRZMA_PRIVATE_IP=0.0.0.0
