# ─────────────────────────────────────────────────────────────────────────
# PRZMA backend — environment template
#
#   cp .env.example .env        # then fill in the blank values in .env
#   set -a; source .env; set +a # load into the current shell
#   mix phx.server
#
# .env is in .gitignore. Put real passwords/keys ONLY in .env, never here.
# Values with special characters (@ # $ ! etc.) go in single quotes.
# ─────────────────────────────────────────────────────────────────────────

# Phoenix
PORT=4000
# Generate once with `mix phx.gen.secret` and paste the output (do not
# use $(...) here — it would create a new secret on every load).
SECRET_KEY_BASE=$(mix phx.gen.secret)

# Keycloak
KEYCLOAK_URL=http://172.235.18.126:8180
KEYCLOAK_REALM=przma

# S3 (Linode Object Storage) — used by ALL Lance tables (doc store + _meta)
# and the CAS blobs. The Rust NIF reads the AWS_* variables directly.
# Never commit real keys here — the keys that were in this file before
# were real and must be rotated.
VAULT_BASE_PATH=s3://perkeep
S3_BUCKET=perkeep
CAS_BACKEND=s3
AWS_ENDPOINT=https://in-maa-1.linodeobjects.com
AWS_DEFAULT_REGION=in-maa-1
S3_REGION=in-maa-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# LanceDB doc store (replaces CouchDB) — all optional, defaults shown
LANCE_WRITER_TIMEOUT_MS=30000
LANCE_WRITER_IDLE_MS=300000
LANCE_QUERY_MAX_ROWS=100000
LANCE_COMPACT_INTERVAL_MIN=30
LANCE_COMPACT_MIN_WRITES=50
LANCE_KEEP_VERSIONS_HOURS=1

# ── Testing only (read by scripts/smoke_test.sh, not by the app) ─────────
APP_URL=http://127.0.0.1:4000
KC_CLIENT_ID=przma-app
KC_CLIENT_SECRET=
TEST_USER=kc_testuser1
TEST_PW=

# ── Vector search ─────────────────────────────────────────────
# Embedding model (HuggingFace id or local folder). Unset = minishlab/potion-base-8M
PRZMA_EMBED_MODEL=
# Index uploaded text/PDF files in the background
SEARCH_AUTO_INDEX=false
