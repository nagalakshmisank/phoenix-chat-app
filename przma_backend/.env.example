# ─────────────────────────────────────────────────────────────────────────
# PRZMA backend — environment template
#
#   cp .env.example .env        # then fill in the blank values in .env
#   set -a; source .env; set +a # load into the current shell
#   mix phx.server
#
# .env is in .gitignore. Put real passwords/keys ONLY in .env, never here.
# Values with special characters (@ # $ ! etc.) go in single quotes.
# ─────────────────────────────────────────────────────────────────────────

# Phoenix
PORT=4000
# Generate once with `mix phx.gen.secret` and paste the output (do not
# use $(...) here — it would create a new secret on every load).
SECRET_KEY_BASE=$(mix phx.gen.secret)

# Keycloak
KEYCLOAK_URL=http://172.235.18.126:8180
KEYCLOAK_REALM=przma

# S3 (Linode Object Storage) — used by Lance, Cas and the CouchDB S3 mirror
VAULT_BASE_PATH=s3://perkeep
S3_BUCKET=perkeep
CAS_BACKEND=s3
AWS_ENDPOINT=https://in-maa-1.linodeobjects.com
AWS_DEFAULT_REGION=in-maa-1
S3_REGION=in-maa-1
AWS_ACCESS_KEY_ID=QBQ24J1P1BV957AUYYXV
AWS_SECRET_ACCESS_KEY=LqqbMn1gBggICrvrqQMOKQ57T9rnqeXXOx6x8H7B

# CouchDB — no credentials inside the URL (sent as a Basic auth header)
#   Phoenix on the same server as CouchDB : http://127.0.0.1:5985
#   Phoenix on another machine            : http://172.235.18.126:5985
COUCHDB_URL=http://127.0.0.1:5985
COUCHDB_USER=admin01
COUCHDB_PASSWORD=new.P@ssw0rd
COUCHDB_TIMEOUT_MS=15000

# S3 JSON mirror of CouchDB docs (profile.couch.json next to profile.lance)
S3_MIRROR_ENABLED=true

# ── Testing only (read by scripts/smoke_test.sh, not by the app) ─────────
APP_URL=http://127.0.0.1:4000
KC_CLIENT_ID=przma-app
KC_CLIENT_SECRET=
TEST_USER=kc_testuser1
TEST_PW=
